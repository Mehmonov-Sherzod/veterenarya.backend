{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=veterinary_db;Username=postgres;Password=YOUR_DB_PASSWORD_HERE"
  },
  "Jwt": {
    "Issuer": "VeterinaryBackend",
    "Audience": "VeterinaryBackend.Clients",
    "SecretKey": "REPLACE_WITH_A_512_BIT_BASE64_SECRET_KEY",
    "AccessTokenMinutes": 720
  },
  "Admin": {
    "Username": "admin",
    "PasswordHash": "REPLACE_WITH_BCRYPT_HASH_OF_YOUR_PASSWORD",
    "RecoveryKey": "REPLACE_WITH_RANDOM_RECOVERY_KEY"
  },
  "Site": {
    "FrontendUrl": "http://localhost:5500"
  },
  "Storage": {
    "UploadsRelativePath": "uploads",
    "PublicBaseUrl": "/uploads",
    "MaxFileSizeBytes": 52428800
  },
  "TelegramBot": {
    "BotToken": "",
    "Enabled": true,
    "AutoReplyText": "Murojaatingiz qabul qilindi. Admin tez orada ko'rib chiqadi va aloqaga chiqadi.",
    "TargetChannelId": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "AutoMigrateOnStartup": true
  }
}
